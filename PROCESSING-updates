MilleniumDB - done for version of 05 March 2025
  Download and compile current version - see ../reports/install-milleniumdb.text
    cd ${BENCHMARK_HOME}/milleniumdb 
    git clone git@github.com:MillenniumDB/MillenniumDB.git MillenniumDB-<date>
    cd MillenniumDB-<date>
    cmake -Bbuild/Release -DCMAKE_BUILD_TYPE=Release
    cmake --build build/Release/ -j 8
  Install current version
    cd ${BENCHMARK_HOME}/milleniumdb 
    ln -s MillenniumDB-<date> MillenniumDB
    MODIFY arguments in MilleniumDB-run as per email
     --threads 1 --versioned-buffer 70GB --unversioned-buffer 4GB --private-buffer 4GB --strings-static 75GB --strings-dynamic 4GB --timeout 600
  Load Wikidata into MillenniumDB - needed to be done for 05mar2025
    cd ${BENCHMARK_HOME}/benchmark
    mkdir milleniumdb-wikidata-<date>
    ln -s milleniumdb-wikidata-<date> milleniumdb-wikidata 
    cd milleniumdb-wikidata 
    cp ${BENCHMARK_HOME}/benchmark/milleniumdb-wikidata-jan2025/wikidata-prefixes.txt .
    ${BENCHMARK_HOME}/milleniumdb/MillenniumDB/build/Release/bin/mdb-import ${BENCHMARK_HOME}/wikidata/wikidata-combined.ttl DB --buffer 120GB --prefixes wikidata-prefixes.txt
  Run existing benchmarks
    cd ~/research/wikidata/benchmark/project/queries 
    ./run-existing MilleniumDB
  Run Scholia benchmark
    cd ~/research/wikidata/benchmark/project/queries 
    ./run-scholia MilleniumDB

