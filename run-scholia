#!/bin/tcsh
# ./run-scholia <engine> <directory suffix for results> [<version of Wikidata>]
# Run the existing benchmarks
# Needs the -run script to be set up for $version.  

if ( $#argv < 1 ) exit
set area = $2
if ( $#argv < 2 ) set area = new
set version = $2
if ( $#argv > 2 ) set version = $3

mkdir -p results-$area
echo "Scholia wikidata version $version" | tee results-$area/scholia-version-$1

/home/local/scripts/$1-stop
/home/local/scripts/$1-run $version

foreach category ( index author award catalogue chemical chemical-class chemical-element clinical-trial complex \
                   country dataset disease event event-series gene ontology organization pathway \
		   podcast podcast-episode podcast-season project property protein publisher \
		   series software sponsor taxon topic use venue wikiproject work )
  echo CATEGORY ${category}
##  /home/local/scripts/$1-run $version
  ./benchmark.py -S --engine=$1 --directory=scholia-new ${category}  | tee results-$area/SCHOLIA-${category}-$1.tsv
##  /home/local/scripts/$1-stop
end

/home/local/scripts/$1-stop
