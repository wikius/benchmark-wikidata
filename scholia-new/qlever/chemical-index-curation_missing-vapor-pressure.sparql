PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?wikis ?compound ?compoundLabel ?formula WHERE {
  {
    SELECT ?wikis ?compound WHERE {
      ?compound wdt:P31 wd:Q113145171 ;
                wikibase:sitelinks ?wikis . # hint:Prior hint:rangeSafe true .
      FILTER (?wikis >= 40)
      FILTER (NOT EXISTS {
          ?compound wdt:P2119 []
        })
    }
    ORDER BY DESC(?wikis)
    LIMIT 100
  }
  OPTIONAL {
    ?compound wdt:P274 ?formula
  }
  BIND (IF(BOUND (?compound), ?compound, <http://doesntexist.example.com/nexistepas>) AS ?compoundLabel__)
  OPTIONAL { ?compoundLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?compoundLabel. FILTER(LANG(?compoundLabel) = "en") }
  OPTIONAL { ?compoundLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?compoundLabel. FILTER(LANG(?compoundLabel) = "mul") }
}
ORDER BY DESC(?wikis)
