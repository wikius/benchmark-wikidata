# title: biological processes in which this chemical is involved
PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT DISTINCT ?pathway ?pathwayLabel (CONCAT("/pathway/", SUBSTR(STR(?pathway),32)) AS ?pathwayUrl) ?pathwayDescription WHERE {
  ?pathway wdt:P527 target: ;
           wdt:P31 wd:Q2996394 .
  target: wdt:P361 ?pathway .
  BIND (IF(BOUND (?pathway), ?pathway, <http://doesntexist.example.com/nexistepas>) AS ?pathwayLabel__)
  OPTIONAL { ?pathwayLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?pathwayLabel. FILTER(LANG(?pathwayLabel) = "en") }
  OPTIONAL { ?pathwayLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?pathwayLabel. FILTER(LANG(?pathwayLabel) = "mul") }
  BIND (IF(BOUND (?pathway), ?pathway, <http://doesntexist.example.com/nexistepas>) AS ?pathwayDescription__)
  OPTIONAL { ?pathwayDescription__ <http://schema.org/description> ?pathwayDescription. FILTER(LANG(?pathwayDescription) = "en") }
  OPTIONAL { ?pathwayDescription__ <http://schema.org/description> ?pathwayDescription. FILTER(LANG(?pathwayDescription) = "mul") }
}
ORDER BY ASC(?pathwayLabel)
LIMIT 250
