PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
SELECT ?quantity ?part ?partLabel ?partDescription ?type WHERE {
  {
    SELECT ?part ?quantity (GROUP_CONCAT(DISTINCT ?type_label; SEPARATOR=", ") AS ?type) WHERE {
      VALUES ?complex { target: }
      ?complex p:P527 ?partStatement .
      ?partStatement ps:P527 ?part .
      OPTIONAL {
        ?partStatement pq:P1114 ?quantity
      }
      OPTIONAL {
        ?part wdt:P31 ?type_ .
        ?type_ rdfs:label ?type_label .
        FILTER (LANG(?type_label) = 'en')
      }
    }
    GROUP BY ?part ?quantity
  }
  BIND (IF(BOUND (?part), ?part, <http://doesntexist.example.com/nexistepas>) AS ?partLabel__)
  OPTIONAL { ?partLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?partLabel. FILTER(LANG(?partLabel) = "en") }
  OPTIONAL { ?partLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?partLabel. FILTER(LANG(?partLabel) = "mul") }
  BIND (IF(BOUND (?part), ?part, <http://doesntexist.example.com/nexistepas>) AS ?partDescription__)
  OPTIONAL { ?partDescription__ <http://schema.org/description> ?partDescription. FILTER(LANG(?partDescription) = "en") }
  OPTIONAL { ?partDescription__ <http://schema.org/description> ?partDescription. FILTER(LANG(?partDescription) = "mul") }
}
ORDER BY ASC(?partLabel)
