PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?number_of_citing_works ?author ?authorLabel ?organization ?organizationLabel ?example_work ?example_workLabel WHERE {
  {
    SELECT ?author (COUNT(DISTINCT ?citing_work) AS ?number_of_citing_works) ?organization ?organizationLabel (SAMPLE(?work) AS ?example_work) WHERE {
      {
        SELECT DISTINCT ?author WHERE {
          ?author wdt:P27 | wdt:P1416/wdt:P17 | wdt:P108/wdt:P17 target: .
        }
      } 
      UNION
      {
        SELECT DISTINCT ?author ?organization ?organizationLabel WHERE {
          {
            SELECT DISTINCT ?author (SAMPLE (?organization_) AS ?organization) WHERE {
              ?author wdt:P27 | wdt:P1416/wdt:P17 | wdt:P108/wdt:P17 target: .
 	      ?author wdt:P1416 | wdt:P108 ?organization_ .
 	      ?organization_ wdt:P17 target:
            } GROUP BY ?author
          }
  BIND (IF(BOUND (?organization), ?organization, <http://doesntexist.example.com/nexistepas>) AS ?organizationLabel__)
  OPTIONAL { ?organizationLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?organizationLabel. FILTER(LANG(?organizationLabel) = "en") }
  OPTIONAL { ?organizationLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?organizationLabel. FILTER(LANG(?organizationLabel) = "mul") }
        }
      }
      ?work wdt:P50 ?author .
      OPTIONAL {
        ?citing_work wdt:P2860 ?work .
      }
      OPTIONAL {
        ?author wdt:P1416 | wdt:P108 ?organization_ .
        ?organization_ wdt:P17 target:
      }
    } GROUP BY ?author ?organization ?organizationLabel
  }
  BIND (IF(BOUND (?author), ?author, <http://doesntexist.example.com/nexistepas>) AS ?authorLabel__)
  OPTIONAL { ?authorLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?authorLabel. FILTER(LANG(?authorLabel) = "en") }
  OPTIONAL { ?authorLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?authorLabel. FILTER(LANG(?authorLabel) = "mul") }
  BIND (IF(BOUND (?example_work), ?example_work, <http://doesntexist.example.com/nexistepas>) AS ?example_workLabel__)
  OPTIONAL { ?example_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_workLabel. FILTER(LANG(?example_workLabel) = "en") }
  OPTIONAL { ?example_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_workLabel. FILTER(LANG(?example_workLabel) = "mul") }
}
ORDER BY DESC(?number_of_citing_works)
LIMIT 1000
