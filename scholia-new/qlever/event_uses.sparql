# Use by people associated with an event
PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?number_of_persons ?use ?useLabel (CONCAT("/use/", SUBSTR(STR(?use),32)) AS ?useUrl) ?useDescription ?example_person ?example_personLabel (CONCAT("/author/", SUBSTR(STR(?example_person),32)) AS ?example_personUrl) WHERE {
  {
    SELECT (COUNT(DISTINCT ?person) AS ?number_of_persons) ?use (SAMPLE(?person) AS ?example_person) WHERE {
      {
        SELECT DISTINCT ?person WHERE {
          {
            # speaker, organizer, program committee member
            target: wdt:P823 | wdt:P664 | wdt:P5804 ?person .
          }
          UNION {
            # participant
            ?person wdt:P1344 | ^wdt:P710 target: .
          }
          UNION {
            # author
            ?person ^wdt:P50/wdt:P1433/wdt:P4745 target: .
          }
        }
      }
      ?person ^wdt:P50/wdt:P4510 ?use .
    }
    GROUP BY ?use
  }
  BIND (IF(BOUND (?use), ?use, <http://doesntexist.example.com/nexistepas>) AS ?useLabel__)
  OPTIONAL { ?useLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?useLabel. FILTER(LANG(?useLabel) = "en") }
  OPTIONAL { ?useLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?useLabel. FILTER(LANG(?useLabel) = "mul") }
  BIND (IF(BOUND (?example_person), ?example_person, <http://doesntexist.example.com/nexistepas>) AS ?example_personLabel__)
  OPTIONAL { ?example_personLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_personLabel. FILTER(LANG(?example_personLabel) = "en") }
  OPTIONAL { ?example_personLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_personLabel. FILTER(LANG(?example_personLabel) = "mul") }
  BIND (IF(BOUND (?use), ?use, <http://doesntexist.example.com/nexistepas>) AS ?useDescription__)
  OPTIONAL { ?useDescription__ <http://schema.org/description> ?useDescription. FILTER(LANG(?useDescription) = "en") }
  OPTIONAL { ?useDescription__ <http://schema.org/description> ?useDescription. FILTER(LANG(?useDescription) = "mul") }
}
ORDER BY DESC(?number_of_persons)
LIMIT 200
