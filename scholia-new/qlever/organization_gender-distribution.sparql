PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?count ?gender ?genderLabel WHERE {
  {
    SELECT (COUNT(DISTINCT ?researcher) AS ?count) ?gender WHERE {
      ?researcher (wdt:P108 | wdt:P463 | wdt:P1416)/wdt:P361* target: .
      ?researcher wdt:P21 ?gender .
    }
    GROUP BY ?gender
  }
  BIND (IF(BOUND (?gender), ?gender, <http://doesntexist.example.com/nexistepas>) AS ?genderLabel__)
  OPTIONAL { ?genderLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?genderLabel. FILTER(LANG(?genderLabel) = "en") }
  OPTIONAL { ?genderLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?genderLabel. FILTER(LANG(?genderLabel) = "mul") }
}
ORDER BY DESC(?count)
