PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?researchers ?use ?useLabel (CONCAT("/use/", SUBSTR(STR(?use),32)) AS ?useUrl) ("🔎" AS ?zoom)
  (CONCAT("{{ q }}/use/", SUBSTR(STR(?use), 32)) AS ?zoomUrl)
?useDescription ?samplework ?sampleworkLabel (CONCAT("/work/", SUBSTR(STR(?samplework),32)) AS ?sampleworkUrl) WHERE {
  {
    SELECT DISTINCT ?use (COUNT(DISTINCT ?researcher) AS ?researchers) (SAMPLE(?work) AS ?samplework) WHERE {
      {
        SELECT DISTINCT ?researcher WHERE {
          ?researcher (wdt:P108 | wdt:P463 | wdt:P1416)/wdt:P361* target: .
        }
      }
      ?work wdt:P50 ?researcher .
      ?work wdt:P4510 ?use .
    }
    GROUP BY ?use
    ORDER BY DESC(?researchers)
    LIMIT 500
  }
  BIND (IF(BOUND (?samplework), ?samplework, <http://doesntexist.example.com/nexistepas>) AS ?sampleworkLabel__)
  OPTIONAL { ?sampleworkLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?sampleworkLabel. FILTER(LANG(?sampleworkLabel) = "en") }
  OPTIONAL { ?sampleworkLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?sampleworkLabel. FILTER(LANG(?sampleworkLabel) = "mul") }
  BIND (IF(BOUND (?use), ?use, <http://doesntexist.example.com/nexistepas>) AS ?useLabel__)
  OPTIONAL { ?useLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?useLabel. FILTER(LANG(?useLabel) = "en") }
  OPTIONAL { ?useLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?useLabel. FILTER(LANG(?useLabel) = "mul") }
  BIND (IF(BOUND (?use), ?use, <http://doesntexist.example.com/nexistepas>) AS ?useDescription__)
  OPTIONAL { ?useDescription__ <http://schema.org/description> ?useDescription. FILTER(LANG(?useDescription) = "en") }
  OPTIONAL { ?useDescription__ <http://schema.org/description> ?useDescription. FILTER(LANG(?useDescription) = "mul") }
}
GROUP BY ?researchers ?use ?useLabel ?useDescription ?samplework ?sampleworkLabel
ORDER BY DESC(?researchers)
