#defaultView:LineChart
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?year_of_citation ?number_of_citations ?organization ?organizationLabel
WHERE {
  # Since 1990
  # FILTER (?year_of_citation >= "1990")
  # Label the results
  { # Count citations per year per organization
    SELECT ?year_of_citation (COUNT(?citing_work) AS ?number_of_citations)
           ?organization ?organizationLabel
    WHERE {
      VALUES ?organization { {% for q in qs %} wd:{{ q }} {% endfor %} }
      ?work wdt:P50/(wdt:P108 | wdt:P463 | (wdt:P1416/wdt:P361*)) ?organization .
      ?citing_work wdt:P2860 ?work .
      ?citing_work wdt:P577 ?publication_date .
      BIND (STR(YEAR(?publication_date)) AS ?year_of_citation)
  BIND (IF(BOUND (?organization), ?organization, <http://doesntexist.example.com/nexistepas>) AS ?organizationLabel__)
  OPTIONAL { ?organizationLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?organizationLabel. FILTER(LANG(?organizationLabel) = "en") }
  OPTIONAL { ?organizationLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?organizationLabel. FILTER(LANG(?organizationLabel) = "mul") }
    }
    GROUP BY ?year_of_citation ?organization ?organizationLabel
  }
}
ORDER BY ?year_of_citation
