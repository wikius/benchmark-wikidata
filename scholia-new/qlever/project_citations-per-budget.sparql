PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX psv: <http://www.wikidata.org/prop/statement/value/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?cites_per_million ?citations ?budget ?currency ?currencyLabel ?short_name ?project ?projectLabel WHERE {
  {
    SELECT (COUNT(?citing_work) / ?budget * 1000000 AS ?cites_per_million) (COUNT(?citing_work) AS ?citations) ?budget ?currency ?project WHERE {
      ?project p:P2769/psv:P2769 ?budget_value .
      ?budget_value wikibase:quantityAmount ?budget .
      ?budget_value wikibase:quantityUnit ?currency .
      ?work wdt:P859 ?project .
      ?citing_work wdt:P2860 ?work .
    }
    GROUP BY ?project ?budget ?currency
  }
  OPTIONAL {
    ?project wdt:P1813 ?short_name
  }
  BIND (IF(BOUND (?project), ?project, <http://doesntexist.example.com/nexistepas>) AS ?projectLabel__)
  OPTIONAL { ?projectLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?projectLabel. FILTER(LANG(?projectLabel) = "en") }
  OPTIONAL { ?projectLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?projectLabel. FILTER(LANG(?projectLabel) = "mul") }
  BIND (IF(BOUND (?currency), ?currency, <http://doesntexist.example.com/nexistepas>) AS ?currencyLabel__)
  OPTIONAL { ?currencyLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?currencyLabel. FILTER(LANG(?currencyLabel) = "en") }
  OPTIONAL { ?currencyLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?currencyLabel. FILTER(LANG(?currencyLabel) = "mul") }
} ORDER BY DESC(?cites_per_million)
