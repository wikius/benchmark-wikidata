PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT ?works ?venue ?venueLabel (CONCAT("../venue/", SUBSTR(STR(?venue),32)) AS ?venueUrl) ?venueDescription WHERE {
  {
    SELECT (COUNT(?work) AS ?works) ?venue WHERE {
      ?work wdt:P31 wd:Q45182324 ;
            wdt:P1433 ?venue .
    }
    GROUP BY ?venue
    ORDER BY DESC(?works)
    LIMIT 200
  }
  
  BIND (IF(BOUND (?venue), ?venue, <http://doesntexist.example.com/nexistepas>) AS ?venueLabel__)
  OPTIONAL { ?venueLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?venueLabel. FILTER(LANG(?venueLabel) = "en") }
  OPTIONAL { ?venueLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?venueLabel. FILTER(LANG(?venueLabel) = "mul") }
  BIND (IF(BOUND (?venue), ?venue, <http://doesntexist.example.com/nexistepas>) AS ?venueDescription__)
  OPTIONAL { ?venueDescription__ <http://schema.org/description> ?venueDescription. FILTER(LANG(?venueDescription) = "en") }
  OPTIONAL { ?venueDescription__ <http://schema.org/description> ?venueDescription. FILTER(LANG(?venueDescription) = "mul") }
}
ORDER BY DESC(?works)
