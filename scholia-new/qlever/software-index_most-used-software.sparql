PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?count ?software ?softwareLabel ?softwareUrl ?described_by_example ?described_by_exampleLabel ?example_use ?example_useLabel WHERE {
  {
    SELECT (COUNT(DISTINCT ?work) AS ?count) ?software (CONCAT("/software/", SUBSTR(STR(?software),32)) AS ?softwareUrl) (SAMPLE(?described_by) AS ?described_by_example) (SAMPLE(?work) AS ?example_use) WHERE {
      ?work wdt:P4510 ?software .
      ?software wdt:P31/wdt:P279* wd:Q7397 .
      # Restricting to work takes too long time :(    
      # ?work wdt:P31/wdt:P279* wd:Q386724 .
      OPTIONAL {
        ?software wdt:P1343 ?described_by .
      }
    }
    GROUP BY ?software
  }
  BIND (IF(BOUND (?example_use), ?example_use, <http://doesntexist.example.com/nexistepas>) AS ?example_useLabel__)
  OPTIONAL { ?example_useLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_useLabel. FILTER(LANG(?example_useLabel) = "en") }
  OPTIONAL { ?example_useLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_useLabel. FILTER(LANG(?example_useLabel) = "mul") }
  BIND (IF(BOUND (?software), ?software, <http://doesntexist.example.com/nexistepas>) AS ?softwareLabel__)
  OPTIONAL { ?softwareLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?softwareLabel. FILTER(LANG(?softwareLabel) = "en") }
  OPTIONAL { ?softwareLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?softwareLabel. FILTER(LANG(?softwareLabel) = "mul") }
  BIND (IF(BOUND (?described_by_example), ?described_by_example, <http://doesntexist.example.com/nexistepas>) AS ?described_by_exampleLabel__)
  OPTIONAL { ?described_by_exampleLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?described_by_exampleLabel. FILTER(LANG(?described_by_exampleLabel) = "en") }
  OPTIONAL { ?described_by_exampleLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?described_by_exampleLabel. FILTER(LANG(?described_by_exampleLabel) = "mul") }
}
ORDER BY DESC(?count)
LIMIT 500
