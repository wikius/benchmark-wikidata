
PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
SELECT ?count ?award ?awardLabel (CONCAT("/award/", SUBSTR(STR(?award), 32)) AS ?awardUrl) ?recipients ?recipientsUrl WHERE {
  {
    SELECT (COUNT(?researcher) AS ?count) ?award (GROUP_CONCAT(?researcherLabel; SEPARATOR=", ") AS ?recipients) (CONCAT("../authors/", GROUP_CONCAT(SUBSTR(STR(?researcher), 32); SEPARATOR=",")) AS ?recipientsUrl) WHERE {
      {
        SELECT DISTINCT ?researcher ?award WHERE {
          ?work wdt:P921 target: .
          ?work wdt:P50 ?researcher .
          ?researcher wdt:P166 ?award .
        }
      }
  BIND (IF(BOUND (?researcher), ?researcher, <http://doesntexist.example.com/nexistepas>) AS ?researcherLabel__)
  OPTIONAL { ?researcherLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?researcherLabel. FILTER(LANG(?researcherLabel) = "en") }
  OPTIONAL { ?researcherLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?researcherLabel. FILTER(LANG(?researcherLabel) = "mul") }
    }
    GROUP BY ?award
  }

  BIND (IF(BOUND (?award), ?award, <http://doesntexist.example.com/nexistepas>) AS ?awardLabel__)
  OPTIONAL { ?awardLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?awardLabel. FILTER(LANG(?awardLabel) = "en") }
  OPTIONAL { ?awardLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?awardLabel. FILTER(LANG(?awardLabel) = "mul") }
}
GROUP BY ?count ?award ?awardLabel ?recipients ?recipientsUrl
ORDER BY DESC(?count)
