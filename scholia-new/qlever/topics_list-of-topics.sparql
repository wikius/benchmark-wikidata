
# title: List of topics
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
SELECT ?topic ?topicLabel ?topicDescription (CONCAT("/topic/", SUBSTR(STR(?topic), 32)) AS ?topicUrl) ?example_work ?example_workLabel (CONCAT("/work/", SUBSTR(STR(?example_work), 32)) AS ?example_workUrl) WHERE {
  {
    SELECT ?topic (SAMPLE(?work) AS ?example_work) WHERE {
      VALUES ?topic { {% for q in qs -%} wd:{{ q }} {% endfor -%} }
      OPTIONAL {
        ?work wdt:P921 ?topic ;
              wdt:P31 wd:Q13442814 .
      }
    }
    GROUP BY ?topic
  }

  BIND (IF(BOUND (?topic), ?topic, <http://doesntexist.example.com/nexistepas>) AS ?topicLabel__)
  OPTIONAL { ?topicLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?topicLabel. FILTER(LANG(?topicLabel) = "en") }
  OPTIONAL { ?topicLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?topicLabel. FILTER(LANG(?topicLabel) = "mul") }
  BIND (IF(BOUND (?example_work), ?example_work, <http://doesntexist.example.com/nexistepas>) AS ?example_workLabel__)
  OPTIONAL { ?example_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_workLabel. FILTER(LANG(?example_workLabel) = "en") }
  OPTIONAL { ?example_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?example_workLabel. FILTER(LANG(?example_workLabel) = "mul") }
  BIND (IF(BOUND (?topic), ?topic, <http://doesntexist.example.com/nexistepas>) AS ?topicDescription__)
  OPTIONAL { ?topicDescription__ <http://schema.org/description> ?topicDescription. FILTER(LANG(?topicDescription) = "en") }
  OPTIONAL { ?topicDescription__ <http://schema.org/description> ?topicDescription. FILTER(LANG(?topicDescription) = "mul") }
}
