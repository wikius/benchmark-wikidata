
#defaultView:BubbleChart
PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
SELECT ?count ?topic ?topicLabel WHERE {
  {
    SELECT (COUNT(?work) AS ?count) ?topic WHERE {
      ?work wdt:P4510/wdt:P279* target: ;
            wdt:P921 ?topic .
    }
    GROUP BY ?topic
    ORDER BY DESC(?count)
    LIMIT 200
  }
  BIND (IF(BOUND (?topic), ?topic, <http://doesntexist.example.com/nexistepas>) AS ?topicLabel__)
  OPTIONAL { ?topicLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?topicLabel. FILTER(LANG(?topicLabel) = "en") }
  OPTIONAL { ?topicLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?topicLabel. FILTER(LANG(?topicLabel) = "mul") }
}
ORDER BY DESC(?count)
