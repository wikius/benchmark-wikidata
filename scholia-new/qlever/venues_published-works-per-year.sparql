
#defaultView:LineChart
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
SELECT ?year (COUNT(?work) AS ?count) ?venue ?venueLabel WHERE {
  VALUES ?venue { {% for q in qs -%} wd:{{ q }} {% endfor -%} }
  ?work wdt:P1433 ?venue .
  ?work wdt:P577 ?publication_datetime .
  BIND (STR(YEAR(?publication_datetime)) AS ?year)
  BIND (IF(BOUND (?venue), ?venue, <http://doesntexist.example.com/nexistepas>) AS ?venueLabel__)
  OPTIONAL { ?venueLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?venueLabel. FILTER(LANG(?venueLabel) = "en") }
  OPTIONAL { ?venueLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?venueLabel. FILTER(LANG(?venueLabel) = "mul") }
}
GROUP BY ?year ?venue ?venueLabel
ORDER BY ?year
