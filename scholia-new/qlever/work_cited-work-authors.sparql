
#title: List of authors with works that are cited by the specified work
#defaultView:Table
PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
SELECT ?cited_works ?author ?authorLabel ?authorDescription (CONCAT("/author/", SUBSTR(STR(?author),32)) AS ?authorUrl) ?cited_work_example ?cited_work_exampleLabel (CONCAT("/work/", SUBSTR(STR(?cited_work_example),32)) AS ?cited_work_exampleUrl) WHERE {
  {
    SELECT (COUNT(?cited_work) AS ?cited_works) ?author (SAMPLE(?cited_work) AS ?cited_work_example) WHERE {
      # Find works that are cited by the queried work
      target: wdt:P2860 ?cited_work .
      ?cited_work wdt:P50 ?author .
    }
    GROUP BY ?author
    # Limit the number of results to avoid downloading too much data
    ORDER BY DESC(?cited_works)
    LIMIT 1000
  }
  # Label the result
  BIND (IF(BOUND (?author), ?author, <http://doesntexist.example.com/nexistepas>) AS ?authorLabel__)
  OPTIONAL { ?authorLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?authorLabel. FILTER(LANG(?authorLabel) = "en") }
  OPTIONAL { ?authorLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?authorLabel. FILTER(LANG(?authorLabel) = "mul") }
  BIND (IF(BOUND (?cited_work_example), ?cited_work_example, <http://doesntexist.example.com/nexistepas>) AS ?cited_work_exampleLabel__)
  OPTIONAL { ?cited_work_exampleLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?cited_work_exampleLabel. FILTER(LANG(?cited_work_exampleLabel) = "en") }
  OPTIONAL { ?cited_work_exampleLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?cited_work_exampleLabel. FILTER(LANG(?cited_work_exampleLabel) = "mul") }
  BIND (IF(BOUND (?author), ?author, <http://doesntexist.example.com/nexistepas>) AS ?authorDescription__)
  OPTIONAL { ?authorDescription__ <http://schema.org/description> ?authorDescription. FILTER(LANG(?authorDescription) = "en") }
  OPTIONAL { ?authorDescription__ <http://schema.org/description> ?authorDescription. FILTER(LANG(?authorDescription) = "mul") }
}
ORDER BY DESC(?cited_works)
