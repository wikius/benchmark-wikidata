
#title: List of works that is cited by the specified work
#defaultView:Table
PREFIX target: <http://www.wikidata.org/entity/{{ q }}>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?citations ?publication_date ?cited_work ?cited_workLabel (GROUP_CONCAT(DISTINCT ?intentionLabel; SEPARATOR=", ") AS ?intentions) WHERE {
  {
    SELECT (MIN(?date) AS ?publication_date) (COUNT(DISTINCT ?citing_cited_work) AS ?citations) ?cited_work WHERE {
      target: wdt:P2860 ?cited_work .
      OPTIONAL {
        ?cited_work wdt:P577 ?datetime .
        BIND (xsd:date(?datetime) AS ?date)
      }
      OPTIONAL {
        ?citing_cited_work wdt:P2860 ?cited_work
      }
    }
    GROUP BY ?cited_work
  }
  OPTIONAL {
    target: p:P2860 ?citationStatement .
    ?citationStatement pq:P3712 ?intention ;
                       ps:P2860 ?cited_work .
  BIND (IF(BOUND (?intention), ?intention, <http://doesntexist.example.com/nexistepas>) AS ?intentionLabel__)
  OPTIONAL { ?intentionLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?intentionLabel. FILTER(LANG(?intentionLabel) = "en") }
  OPTIONAL { ?intentionLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?intentionLabel. FILTER(LANG(?intentionLabel) = "mul") }
  }
  BIND (IF(BOUND (?cited_work), ?cited_work, <http://doesntexist.example.com/nexistepas>) AS ?cited_workLabel__)
  OPTIONAL { ?cited_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?cited_workLabel. FILTER(LANG(?cited_workLabel) = "en") }
  OPTIONAL { ?cited_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?cited_workLabel. FILTER(LANG(?cited_workLabel) = "mul") }
}
GROUP BY ?citations ?publication_date ?cited_work ?cited_workLabel
ORDER BY DESC(?citations) DESC(?date)
