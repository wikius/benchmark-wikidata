
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?count (MIN(?dates) AS ?date) ?citing_work ?citing_workLabel WHERE {
  {
    SELECT (COUNT(?work) AS ?count) ?citing_work WHERE {
      VALUES ?work { {% for q in qs -%} wd:{{ q }} {% endfor -%} }
      ?citing_work wdt:P2860 ?work .
    }
    GROUP BY ?citing_work
    ORDER BY DESC(?count)
    LIMIT 200
  }
  OPTIONAL {
    ?citing_work wdt:P577 ?datetimes .
    BIND (xsd:date(?datetimes) AS ?dates)
  }
  BIND (IF(BOUND (?citing_work), ?citing_work, <http://doesntexist.example.com/nexistepas>) AS ?citing_workLabel__)
  OPTIONAL { ?citing_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?citing_workLabel. FILTER(LANG(?citing_workLabel) = "en") }
  OPTIONAL { ?citing_workLabel__ <http://www.w3.org/2000/01/rdf-schema#label> ?citing_workLabel. FILTER(LANG(?citing_workLabel) = "mul") }
}
GROUP BY ?count ?citing_work ?citing_workLabel
ORDER BY DESC(?count) DESC(?date)
