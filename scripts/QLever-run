#!/bin/tcsh

cd ${BENCHMARK_HOME}/benchmark/qlever-wikidata
${BENCHMARK_HOME}/scripts/cache
echo "\n\nSTARTING QLEVER" >> /tmp/QLever
${BENCHMARK_HOME}/qlever/qlever-code/build/ServerMain --index-basename wikidata --port 7001 --memory-max-size 142G --cache-max-size 32G --default-query-timeout 600s >> /tmp/QLever   &
sleep 30s
